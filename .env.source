BEETLE_API=http://localhost:8337

# host of beetle (without base); only required for the RSS feed
BEETLE_HOST=http://localhost:3000

# you must not put slash at the end of base
# e.g. /beetle/ fails, and /beetle works
BEETLE_BASE=/

# beet web api do not serve file
# by supporting partial content HTTP method (code 206)
# you may want to serve the files using another static access point
# Setting the following parameters enables an alternative access
# It first requires that web.path is set to true in your beet configuration !
#
# root directory of your library
# BEETLE_FILES_DIR=/mnt/music
# access url of the library root
# BEETLE_FILES_URL=https://example.com/music/

# the list of the playlist names separated by a comma that should appear on the index page
# comment the next line in order that the playlists index do not appear in the navigation bar
# BEETLE_PLAYLISTS=funky, jazzy